# PseudoPilot — environment template (Milestone 1)
# Copy to .env for local use. Never commit real secrets.

NODE_ENV=development

# Prefer PgBouncer (6432) so local habits match multi-replica production.
# Direct Postgres (5432) is fine for one-off DB admin only.
DATABASE_URL=postgresql://pseudopilot:pseudopilot@localhost:6432/pseudopilot
DATABASE_URL_ADMIN=postgresql://pseudopilot:pseudopilot@localhost:5432/pseudopilot

REDIS_URL=redis://localhost:6379

# API (stateless — safe to run multiple replicas later)
API_PORT=3001
API_HOST=0.0.0.0
API_REPLICAS_HINT=1

# Web apps
WEB_PORT=3000
TEACHER_PORT=3002

# Sandbox / worker scaling hints (used when those services are implemented)
SANDBOX_MAX_CONCURRENT=32
SANDBOX_QUEUE_SOFT_LIMIT=500
WORKER_CONCURRENCY=8

# Rate limits (per minute) — enforce at gateway + Redis
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_ORG_EXECUTE_PER_MIN=600

# Auth (placeholders — not wired yet)
# AUTH_SECRET=replace-with-long-random-string

# AI coach (optional; never required for parse/run/translate)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
