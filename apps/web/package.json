{
  "name": "@pseudopilot/web",
  "version": "1.0.0-beta.0",
  "private": true,
  "description": "PseudoPilot student IDE — Monaco, live sync, interpreter, debugger (1.0.0-beta).",
  "scripts": {
    "docs:corpus": "node scripts/generate-docs-corpus.mjs",
    "predev": "node scripts/generate-docs-corpus.mjs",
    "prebuild": "node scripts/generate-docs-corpus.mjs",
    "pretest": "node scripts/generate-docs-corpus.mjs",
    "dev": "next dev --port 3000 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 3000 --hostname 127.0.0.1",
    "lint": "node ../../node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@pseudopilot/ai-coach": "workspace:*",
    "@pseudopilot/checker": "workspace:*",
    "@pseudopilot/compiler-service": "workspace:*",
    "@pseudopilot/interpreter": "workspace:*",
    "@pseudopilot/language-service": "workspace:*",
    "@pseudopilot/translator": "workspace:*",
    "clsx": "^2.1.1",
    "monaco-editor": "0.52.2",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
