{
  "name": "@pseudopilot/language-core",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Deterministic lexer, parser, and AST for Cambridge 9618 pseudocode. Pure library: no I/O, no DB, no network.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jibrilapp/PseudoPilot.git",
    "directory": "packages/language-core"
  },
  "bugs": {
    "url": "https://github.com/jibrilapp/PseudoPilot/issues"
  },
  "homepage": "https://github.com/jibrilapp/PseudoPilot/tree/main/packages/language-core",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@pseudopilot/eslint-config": "workspace:*",
    "@pseudopilot/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
