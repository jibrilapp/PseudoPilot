{
  "name": "@pseudopilot/translator",
  "version": "1.0.0-beta.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AST-to-AST bidirectional translation between pseudocode and Python via canonical IR.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jibrilapp/PseudoPilot.git",
    "directory": "packages/translator"
  },
  "bugs": {
    "url": "https://github.com/jibrilapp/PseudoPilot/issues"
  },
  "homepage": "https://github.com/jibrilapp/PseudoPilot/tree/main/packages/translator",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "pnpm run build && vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@pseudopilot/checker": "workspace:*",
    "@pseudopilot/language-core": "workspace:*"
  },
  "devDependencies": {
    "@pseudopilot/eslint-config": "workspace:*",
    "@pseudopilot/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
