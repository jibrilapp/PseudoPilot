{
  "name": "@pseudopilot/ai-coach",
  "version": "1.0.0-beta.0",
  "private": true,
  "type": "module",
  "description": "LLM provider abstraction, prompt builders, and grounded explanation pipelines.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@pseudopilot/eslint-config": "workspace:*",
    "@pseudopilot/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
