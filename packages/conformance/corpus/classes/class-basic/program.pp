CLASS Counter
  PRIVATE Value : INTEGER
  PUBLIC PROCEDURE NEW(Start : INTEGER)
    Value ← Start
  ENDPROCEDURE
  PUBLIC PROCEDURE Bump
    Value ← Value + 1
  ENDPROCEDURE
  PUBLIC FUNCTION Get() RETURNS INTEGER
    RETURN Value
  ENDFUNCTION
ENDCLASS
DECLARE C : Counter
C ← NEW Counter(10)
CALL C.Bump()
OUTPUT C.Get()
