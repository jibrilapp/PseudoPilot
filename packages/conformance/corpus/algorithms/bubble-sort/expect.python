A: list[int] = [0 for _ in range((5) - (1) + 1)]  # ARRAY[1:5]
I: int
J: int
Temp: int
A[1 - 1] = 5
A[2 - 1] = 1
A[3 - 1] = 4
A[4 - 1] = 2
A[5 - 1] = 3
for I in range(1, 4 + 1):
    for J in range(1, 5 - I + 1):
        if A[J - 1] > A[J + 1 - 1]:
            Temp = A[J - 1]
            A[J - 1] = A[J + 1 - 1]
            A[J + 1 - 1] = Temp
for I in range(1, 5 + 1):
    print(A[I - 1])
