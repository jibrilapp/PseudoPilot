{
  "name": "@pseudopilot/conformance",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "PseudoPilot conformance & reliability suite — Cambridge Core corpus, round-trips, stress, fuzz, benchmarks. No language features.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jibrilapp/PseudoPilot.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/jibrilapp/PseudoPilot/issues"
  },
  "homepage": "https://github.com/jibrilapp/PseudoPilot/tree/main/packages/conformance",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./corpus": {
      "types": "./dist/corpus/index.d.ts",
      "import": "./dist/corpus/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "pnpm run build && vitest run",
    "bench": "pnpm run build && vitest run src/bench.bench.ts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@pseudopilot/checker": "workspace:*",
    "@pseudopilot/compiler-service": "workspace:*",
    "@pseudopilot/interpreter": "workspace:*",
    "@pseudopilot/language-core": "workspace:*",
    "@pseudopilot/language-service": "workspace:*",
    "@pseudopilot/translator": "workspace:*"
  },
  "devDependencies": {
    "@pseudopilot/eslint-config": "workspace:*",
    "@pseudopilot/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
